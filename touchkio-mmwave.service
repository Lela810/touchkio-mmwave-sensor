[Unit]
Description=TouchKio C4001 mmWave presence sensor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
SupplementaryGroups=gpio dialout
EnvironmentFile=-/etc/default/touchkio-mmwave
# lgpio creates notification pipes in its working directory, which must be
# writable by the service user; /opt/touchkio-mmwave-sensor is owned by root.
RuntimeDirectory=touchkio-mmwave
WorkingDirectory=/run/touchkio-mmwave
Environment=LG_WD=/run/touchkio-mmwave
ExecStart=/opt/touchkio-mmwave-sensor/venv/bin/python /opt/touchkio-mmwave-sensor/mmwave.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
